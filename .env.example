# SQLite file. Use :memory: in tests (the test helpers set this).
DB_PATH=data/pullups.db

# Optional. Absolute origin of Pullups With Friends (no trailing slash).
# When unset, the "Grade with video" button is hidden.
NEXT_PUBLIC_COMPANION_ORIGIN=

# Optional. Absolute origin of *this* app including the /app base path,
# used as returnTo when opening the companion recorder.
# Example: https://amdai.net/app
NEXT_PUBLIC_APP_ORIGIN=
